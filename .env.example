# AnythingLLM Configuration

ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=your_api_key_here
MSIM_AUTH_TOKEN=replace_with_a_long_random_token
CORS_ORIGINS=http://localhost:3000

# MSIM Configuration

WORKSPACE=sslg                # optional; auto-detect if blank
PORT=8000
MSIM_HOST=127.0.0.1
MSIM_ALLOW_LOCAL_FILE_UPLOAD=false
LOG_LEVEL=info                # debug, info, warning, error
LOG_FORMAT=plain              # plain or json
MAX_LOG_SIZE=10485760         # 10 MB
LOG_BACKUP_COUNT=5

# Supervisor mode (auto-restart)

SUPERVISE_MAX_RESTARTS=5      # per minute
GRACEFUL_SHUTDOWN_TIMEOUT=10  # seconds